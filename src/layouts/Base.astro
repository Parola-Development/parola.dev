---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Parola helps small businesses build, secure, and manage technology — from custom apps to email security and managed IT.',
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath  = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Parola Development Blog" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>

    <header class="site-header">
      <div class="container">
        <nav class="nav">
          <a href="/" class="nav-logo">
            <img
              src="https://cdn.parola.network/logo-white.png"
              alt="Parola Development"
              height="28"
              onerror="this.style.display='none';document.getElementById('logo-fallback').style.display='block'"
            />
            <span id="logo-fallback" style="display:none" class="logo-fallback">
              parola<span class="logo-dot">.</span>dev
            </span>
          </a>
          <div class="nav-links">
            <a href="/services"         class:list={['nav-link', { active: currentPath.startsWith('/services') }]}>Services</a>
            <a href="/cyber-essentials" class:list={['nav-link', { active: currentPath.startsWith('/cyber-essentials') }]}>Cyber Essentials</a>
            <a href="/blog"             class:list={['nav-link', { active: currentPath.startsWith('/blog') }]}>Blog</a>
            <a href="/about"            class:list={['nav-link', { active: currentPath === '/about' }]}>About</a>
            <a href="/contact"          class:list={['nav-link', { active: currentPath === '/contact' }]}>Contact</a>
            <a href="/contact" class="nav-cta btn btn--gold">Free Security Review</a>
          </div>
          <button class="nav-burger" aria-label="Open menu" id="burger">
            <span></span><span></span><span></span>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <div class="footer-brand">
            <img
              src="https://cdn.parola.network/logo-white.png"
              alt="Parola Development"
              height="24"
              class="footer-logo"
              onerror="this.style.display='none'"
            />
            <p class="footer-tagline">Build. Secure. Manage.</p>
            <p class="footer-address">
              Parola Development LTD<br/>
              First Floor, The Annex, Fernhill Court<br/>
              Balsall Common, CV7 7FR<br/>
              <a href="tel:01676478010">01676 478 010</a>
            </p>
          </div>
          <div class="footer-cols">
            <div class="footer-col">
              <p class="footer-col-title">Services</p>
              <a href="/services#build">Build</a>
              <a href="/services#secure">Secure</a>
              <a href="/services#manage">Manage</a>
              <a href="/cyber-essentials">Cyber Essentials</a>
            </div>
            <div class="footer-col">
              <p class="footer-col-title">Company</p>
              <a href="/about">About</a>
              <a href="/blog">Blog</a>
              <a href="/contact">Contact</a>
            </div>
            <div class="footer-col">
              <p class="footer-col-title">Legal</p>
              <a href="/privacy">Privacy Policy</a>
              <a href="/terms">Terms of Service</a>
            </div>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} Parola Development LTD. All rights reserved.</p>
          <div class="footer-bottom-links">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const burger = document.getElementById('burger');
      const navLinks = document.querySelector('.nav-links');
      burger?.addEventListener('click', () => {
        navLinks?.classList.toggle('nav-open');
        burger.classList.toggle('open');
      });
    </script>

  </body>
</html>

<style>
  /* Header */
  .site-header {
    background: var(--navy);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 32px;
  }
  .nav-logo { display: flex; align-items: center; flex-shrink: 0; }
  .logo-fallback {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    color: #fff;
  }
  .logo-dot { color: var(--gold); }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .nav-link {
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover  { color: #fff; background: rgba(255,255,255,0.06); }
  .nav-link.active { color: #fff; }
  .nav-cta { margin-left: 8px; font-size: 13px; padding: 8px 16px; }

  .nav-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: rgba(255,255,255,0.7);
    border-radius: 2px;
    transition: 0.2s;
  }

  /* Footer */
  .site-footer { background: var(--navy); color: rgba(255,255,255,0.5); }
  .footer-inner {
    display: flex;
    gap: 64px;
    padding: 56px 0 40px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .footer-brand { flex-shrink: 0; max-width: 240px; }
  .footer-logo  { margin-bottom: 10px; opacity: 0.8; }
  .footer-tagline {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .footer-address {
    font-size: 12px;
    line-height: 1.75;
    color: rgba(255,255,255,0.35);
  }
  .footer-address a { color: rgba(255,255,255,0.4); }
  .footer-address a:hover { color: rgba(255,255,255,0.7); }
  .footer-cols {
    display: flex;
    gap: 48px;
    margin-left: auto;
  }
  .footer-col { display: flex; flex-direction: column; gap: 10px; }
  .footer-col-title {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  .footer-col a {
    font-size: 13px;
    color: rgba(255,255,255,0.35);
    transition: color 0.15s;
  }
  .footer-col a:hover { color: rgba(255,255,255,0.75); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    font-size: 12px;
    color: rgba(255,255,255,0.25);
  }
  .footer-bottom-links { display: flex; gap: 20px; }
  .footer-bottom-links a { color: rgba(255,255,255,0.25); }
  .footer-bottom-links a:hover { color: rgba(255,255,255,0.5); }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
      position: absolute;
      top: 60px;
      left: 0;
      right: 0;
      background: var(--navy);
      flex-direction: column;
      padding: 16px 20px 24px;
      border-top: 1px solid rgba(255,255,255,0.08);
      gap: 4px;
    }
    .nav-links.nav-open { display: flex; }
    .nav-burger { display: flex; }
    .footer-inner { flex-direction: column; gap: 32px; }
    .footer-cols { flex-wrap: wrap; gap: 32px; margin-left: 0; }
  }
</style>
